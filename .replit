modules = ["nodejs-22", "web", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libpng", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "which", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Worker"

[[workflows.workflow]]
name = "API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# Inference runs in its own process. Running it inside the web server loaded the
# model into every worker and made analysis compete with request handling.
[[workflows.workflow]]
name = "Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && python -m chester.worker"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["bash", "server/run_production.sh"]

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://rx.nelsongodoy.com.br"
STOW_URL = "https://rx.nelsongodoy.com.br"
DICOM_WADO_ANONYMOUS_INGEST = "true"
DICOM_INGEST_OWNER_EMAIL = "nelsonagodoy@gmail.com"
ADMIN_USERS = "nelsonagodoy@gmail.com"
