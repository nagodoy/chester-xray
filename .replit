modules = ["nodejs-22", "web", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libpng", "libtiff", "libwebp", "libxcrypt", "oneDNN", "openjpeg", "postgresql", "re2", "tcl", "tk", "which", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Worker"

[[workflows.workflow]]
name = "API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# Inference runs in its own process and can be deployed/scaled separately from
# the HTTP API. Each worker replica handles one job at a time.
[[workflows.workflow]]
name = "Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash server/run_worker.sh"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5011
externalPort = 3000

[deployment]
deploymentTarget = "cloudrun"
build = ["npm", "run", "build"]
# API-only deployment. A separate worker deployment can use
# `bash server/run_worker.sh`; use `python -m chester.worker --queue-stats`
# as the queue-depth/age signal for an external replica scaler.
run = ["bash", "server/run_production.sh"]

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://rx.nelsongodoy.com.br"
STOW_URL = "https://rx.nelsongodoy.com.br"
DICOM_WADO_ANONYMOUS_INGEST = "true"
DICOM_INGEST_OWNER_EMAIL = "nelsonagodoy@gmail.com"
ADMIN_USERS = "nelsonagodoy@gmail.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
